# Meta Model API key from https://dev.meta.ai (keys start with LLM_)
MODEL_API_KEY=
# Optional overrides
MODEL_BASE_URL=https://api.meta.ai/v1
FLOODLINE_SPARK_MODEL=muse-spark-1.3
FLOODLINE_SAM_MODEL=sam-3.1
# replay: answer model calls from recorded cassettes only; record: call the API and save; live: call the API
FLOODLINE_MODEL_MODE=live

# WhatsApp intake (Cloud API) — see docs/whatsapp.md
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ALLOWED=

# Telegram intake — create a bot with @BotFather; see docs/telegram.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED=
TELEGRAM_HOURLY_LIMIT=20
TELEGRAM_DAILY_LIMIT=150
